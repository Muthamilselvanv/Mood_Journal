{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "nilora-mood-journal-app",
          "appId": "1:23408367101:android:1b0c9032649e121e557594",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "nilora-mood-journal-app",
          "configurations": {
            "android": "1:23408367101:android:1b0c9032649e121e557594",
            "ios": "1:23408367101:ios:836aa34367e086e5557594",
            "web": "1:23408367101:web:2cc70fc1aa89bd6c557594"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "hosting/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  }
}
